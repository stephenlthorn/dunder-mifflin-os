{
  "name": "@dmos/server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch src/main.ts",
    "start": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/main.ts",
    "serve": "DMOS_SERVE_WEB=1 NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/main.ts",
    "demo": "DMOS_SOURCE=fixture NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/main.ts",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "record-fixture": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/record-fixture.ts",
    "live-summary": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/live-summary.ts",
    "portraits:check": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/portraits-check.ts",
    "claude-code:hooks": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/claude-code-hooks.ts",
    "record-meetings": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/record-meetings.ts",
    "record-activity": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/record-activity.ts",
    "live-observability": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/live-observability.ts"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
